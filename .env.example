# Comma-separated providers. Both use unofficial public web interfaces.
ENABLED_PROVIDERS=kleinanzeigen,vinted

# Optional fixed User-Agent. The default is a stable mainstream browser compatibility UA.
# MARKETPLACE_USER_AGENT=

# Optional HTTP(S) forward proxy for deployments whose Vercel egress IP is blocked upstream.
# This value is server-only. Use a provider that permits marketplace requests and review
# marketplace terms; never use it to bypass a CAPTCHA or other access challenge.
# MARKETPLACE_PROXY_URL=https://username:password@proxy.example:8443
